  // Micro (sub-millimetre) height from the shared detail set, -1..1. This is the
  // aggregate / plaster-tooth / grit read at 0.5 m; it fades out with distance so
  // the near ground gains detail instead of shimmering.
  float owMicro = 0.0;
  float owDetFade = 0.0;

