{
  float owDist = length( vViewPosition );
  float owFaceDir = gl_FrontFacing ? 1.0 : -1.0;
  vec3 owNw = normalize( vOwWNrm ) * owFaceDir;

  #ifdef OW_OBJECT_SPACE
