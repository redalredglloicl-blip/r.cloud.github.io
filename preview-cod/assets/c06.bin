  float h = 0.5, rough = 0.5, metal = 0.0, ao = 1.0;
  owSurface(vUv, alb, h, rough, metal, ao);
  if (uOutput == 0)      gl_FragColor = vec4(h, h, h, 1.0);
  else if (uOutput == 1) gl_FragColor = vec4(alb, h);
  else                   gl_FragColor = vec4(ao, rough, metal, 1.0);
}
