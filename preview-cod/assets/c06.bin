  c *= 1.0 - cavity * 0.18;

  alb = clamp(c, vec3(0.02), vec3(0.85));
  rough = clamp(r, 0.14, 0.99);
  metal = clamp(mtl, 0.0, 1.0);
  ao = clamp(ao, 0.2, 1.0);
  h = clamp(h, 0.0, 1.0);
