#tc-ui { position: fixed; inset: 0; z-index: 60; pointer-events: none;
  touch-action: none; -webkit-user-select: none; user-select: none;
  font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }
#tc-ui .tc-btn { position: absolute; pointer-events: auto; display: flex;
  align-items: center; justify-content: center; border-radius: 50%;
  background: rgba(10, 16, 24, 0.42); border: 1.5px solid rgba(140, 190, 255, 0.55);
  color: #d7ecff; font-weight: 700; letter-spacing: 0.08em;
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
  touch-action: none; text-shadow: 0 1px 3px rgba(0,0,0,0.8); }
#tc-ui .tc-btn.on { background: rgba(70, 140, 255, 0.5); border-color: #9fd0ff; }
#tc-fire { right: 30px; bottom: 108px; width: 92px; height: 92px; font-size: 17px; }
#tc-ads  { right: 142px; bottom: 38px;  width: 62px; height: 62px; font-size: 13px; }
#tc-jump { right: 44px;  bottom: 214px; width: 62px; height: 62px; font-size: 20px; }
#tc-rld  { right: 222px; bottom: 44px;  width: 54px; height: 54px; font-size: 11px; }
#tc-swap { right: 152px; bottom: 122px; width: 54px; height: 54px; font-size: 15px; }
#tc-crc  { left: 40px;   bottom: 178px; width: 54px; height: 54px; font-size: 16px; }
#tc-pause{ right: 14px;  top: 14px;     width: 42px; height: 42px; font-size: 15px; }
#tc-stick-base { position: absolute; width: 124px; height: 124px; border-radius: 50%;
  border: 1.5px solid rgba(140, 190, 255, 0.4); background: rgba(10, 16, 24, 0.3);
  display: none; pointer-events: none; transform: translate(-50%, -50%); }
#tc-stick-knob { position: absolute; width: 54px; height: 54px; border-radius: 50%;
  background: rgba(150, 200, 255, 0.5); border: 1.5px solid rgba(200, 230, 255, 0.7);
  display: none; pointer-events: none; transform: translate(-50%, -50%); }
#tc-rotate { position: fixed; inset: 0; z-index: 70; display: none;
  align-items: center; justify-content: center; text-align: center;
  background: rgba(2, 6, 12, 0.88); color: #cfe6ff; font-size: 20px; line-height: 1.9;
  padding: 2rem; pointer-events: none; }
@media (orientation: portrait) { #tc-rotate { display: flex; } }
